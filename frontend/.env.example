# Valores VITE_* são incorporados ao bundle do navegador. Nunca coloque senha,
# token, chave privada, credencial do banco ou qualquer segredo neste arquivo.
#
# Em desenvolvimento local, o proxy usa /api/v1 por padrão; mantenha este valor
# salvo no seu frontend/.env.local apenas se precisar sobrescrever o destino.
VITE_API_BASE_URL=/api/v1
